{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowUnreachableCode": false,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "@webgpu/types",
      "node"
    ]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "src/sw.ts"
  ]
}
